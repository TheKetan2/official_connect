{
  "name": "Official Connect",
  "short_name": "Official Connect",
  "description": "A private workspace for important official WhatsApp groups and contacts.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f9f7",
  "theme_color": "#145c4b",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Group",
      "short_name": "Add Group",
      "description": "Add an official WhatsApp group",
      "url": "./?action=add-group",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Add Contact",
      "short_name": "Add Contact",
      "description": "Add an important contact",
      "url": "./?action=add-contact",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New Note",
      "short_name": "New Note",
      "description": "Create a new work note",
      "url": "./?action=add-note",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Import WhatsApp",
      "short_name": "Import",
      "description": "Import WhatsApp links and contacts",
      "url": "./?action=import",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
